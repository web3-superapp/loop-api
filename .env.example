# Safe local-development defaults. Copy to .env.local; never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
API_DOCS_ENABLED=true
TRUST_PROXY=false
LOG_LEVEL=info

# LOOP v2 session/account slice. It defaults off in NODE_ENV=production and
# still requires working Privy credentials plus the current database migration.
V2_SESSION_ENABLED=true

# V2 client policy gates (Decision 0029). Every gate stays "unavailable" until
# its complete policy is configured; a partial version policy fails startup.
# Minimum versions are SemVer 2.0 and store URLs must be https without
# credentials. All four keys below are required together.
V2_CLIENT_POLICY_MIN_VERSION_IOS=
V2_CLIENT_POLICY_MIN_VERSION_ANDROID=
V2_CLIENT_POLICY_STORE_URL_IOS=
V2_CLIENT_POLICY_STORE_URL_ANDROID=

# Optional hard floors. A client below this version must update before it can
# continue; between this and the minimum it sees a dismissible prompt. Must not
# exceed the platform minimum; blank means the hard floor equals the minimum.
V2_CLIENT_POLICY_FORCE_UPDATE_BELOW_IOS=
V2_CLIENT_POLICY_FORCE_UPDATE_BELOW_ANDROID=

# Policy snapshot identity. Blank keeps the compiled product baseline, but as
# soon as any version or terms gate above/below is configured BOTH keys are
# required (startup fails otherwise). EFFECTIVE_AT is RFC 3339 with an explicit
# timezone, e.g. 2026-09-07T00:00:00Z; while it is still in the future every
# configured gate reports "unavailable" with reasonCode POLICY_NOT_YET_EFFECTIVE.
V2_CLIENT_POLICY_CONFIG_VERSION=
V2_CLIENT_POLICY_EFFECTIVE_AT=

# Terms gate: the terms version every client must present as accepted. Blank
# keeps the gate unavailable.
V2_TERMS_REQUIRED_VERSION=

# V2 module gate: comma-separated set of module IDs whose routes may register.
# Allowed: community,communication,search,market,chain,wallet,swap,
# sendApprovals,launch,mining,referral,notifications,profile,watchlist. Blank
# enables none. "profile" (Decision 0030), "community"/"search" (0031),
# "communication" (0032), "chain"/"wallet"/"watchlist" (0033),
# "market"/"notifications" (0034), "swap"/"sendApprovals" (0035), and
# "launch"/"mining"/"referral" (0036) are delivered.
V2_MODULES_ENABLED=

# Optional comma-separated alias blocklist for V2 profile writes. Each term is
# NFKC-normalised and lower-cased, then matched as a substring of the
# normalised alias; a hit returns ALIAS_BLOCKED. Reserved staff/system words
# (loop, admin, official, support, system, mod, moderator, team) are compiled.
V2_ALIAS_BLOCKED_TERMS=

# Independent server-only HMAC key for owner/route/filter-bound V2 list
# cursors. Generate at least 32 random bytes outside Git. Never commit it.
V2_CURSOR_HMAC_SECRET=

# Leave blank until configured in the Privy dashboard. Never commit real values.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The reviewed v0.7.63 license gate is accepted. Configure only a Development
# Stream App outside Git. Chat and Video share it. Never commit the API secret.
STREAM_API_KEY=
STREAM_API_SECRET=

# Server-only HMAC key for domain-separated Stream-token and alias-search quotas.
# Generate at least 32 random bytes outside Git; raw users and IPs are never stored.
STREAM_TOKEN_QUOTA_HMAC_SECRET=
STREAM_TOKEN_USER_LIMIT_PER_MINUTE=10
STREAM_TOKEN_IP_LIMIT_PER_MINUTE=60

# Audio-room role evidence switch (Decision 0039). Blank keeps
# voiceRooms.evidence pending (AUDIO_ROOM_USER_ROLE_EVIDENCE_PENDING) and the
# mobile voice-room page unavailable. Set it only after archiving a Stream
# Dashboard screenshot that shows, for BOTH the audio_room call type and the
# Global video permissions, the `user` role with Create call = Not allowed,
# Read/Join allowed, Update/End = own only, Delete = Not allowed. The value is
# the archive label of that screenshot (for example
# dashboard-2026-09-10-user-role-no-create-call): 1-120 printable characters,
# no control characters, no URL with credentials, no secret. It is published
# verbatim as voiceRooms.evidence.reference and logged once at startup; the
# screenshot itself stays outside Git wherever operations archives it.
STREAM_AUDIO_ROOM_USER_ROLE_EVIDENCE_REF=

# Independent server-only keys for encrypted, owner-bound social cursors and
# privacy-preserving friend-mutation quotas. Configure both or neither.
SOCIAL_CURSOR_HMAC_SECRET=
SOCIAL_QUOTA_HMAC_SECRET=

# Independent server-only HMAC key for owner/wallet/route-bound Perp read cursors.
# Required only when enabling private reads. Never commit the real value.
PERP_READ_CURSOR_HMAC_SECRET=

# Hyperliquid private reads are default-off and fixed to Testnet/Core.
# Enabling requires Privy credentials, the cursor key above, and a separate
# server-only quota HMAC key. The internal limit stays below provider 1200/min.
HYPERLIQUID_PRIVATE_READS_ENABLED=false
HYPERLIQUID_INFO_QUOTA_HMAC_SECRET=
HYPERLIQUID_INFO_WEIGHT_LIMIT_PER_MINUTE=960

# The standalone worker keeps the retained Perp reader behind its own
# default-off switch. It reuses the global Info quota, performs Testnet reads
# only, and never submits or replays provider writes. API/worker replicas
# sharing one egress must also share this quota secret and capacity.
HYPERLIQUID_RECONCILIATION_READS_ENABLED=false

# Independent default-off gate for the Spot intent lane. It shares that same
# global Info quota but does not enable or depend on Perp reconciliation.
HYPERLIQUID_SPOT_RECONCILIATION_READS_ENABLED=false

# Database-only safety maintenance. This expires elapsed signing handoffs and
# retires elapsed Testnet Spot Agent generations. It never calls Privy or
# Hyperliquid and can be disabled temporarily for operator maintenance.
SPOT_AGENT_LIFECYCLE_MAINTENANCE_ENABLED=true

# Database-only cleanup for expired issuance quota windows. The seven-day
# post-window retention policy is compiled and cannot be shortened here. This
# switch exists only to pause cleanup during explicit database maintenance.
ISSUANCE_RATE_RECORD_CLEANUP_ENABLED=true

# BSC read endpoints: a comma-separated list of http(s) RPC URLs (production
# should configure at least two). Blank leaves every chain read closed and
# reports bscRead as unavailable with BSC_RPC_NOT_CONFIGURED. The endpoint's
# eth_chainId must equal 56; a mismatch stays unavailable with
# BSC_CHAIN_ID_MISMATCH and logs a startup warning instead of crashing. Note
# that some public endpoints refuse eth_getLogs entirely, which the indexer
# lane needs. Endpoint URLs are never published in an API response.
BSC_RPC_URLS=
BSC_CONFIRMATIONS=15
BSC_REORG_DEPTH_BLOCKS=64

# Launch chain slot (Decision 0038). The primary chain above is always
# eip155:56; only the Launch module may point at another chain. 56 (default)
# reuses BSC_RPC_URLS/BSC_CONFIRMATIONS/BSC_REORG_DEPTH_BLOCKS and every
# LAUNCH_BSC_* key must stay blank (startup fails otherwise). 97 is the BSC
# testnet: LAUNCH_BSC_RPC_URLS is its own comma-separated http(s) list (blank
# keeps the slot unavailable with LAUNCH_CHAIN_RPC_NOT_CONFIGURED, never a
# crash); confirmations default to 5 and reorg depth to 15. The endpoint's
# eth_chainId must equal the configured value or the slot reports
# LAUNCH_CHAIN_ID_MISMATCH. Wallet, market, Swap, approvals, and the indexer
# stay on the primary chain regardless of this slot. URLs are never published.
LAUNCH_CHAIN_ID=56
LAUNCH_BSC_RPC_URLS=
LAUNCH_BSC_CONFIRMATIONS=
LAUNCH_BSC_REORG_DEPTH_BLOCKS=

# Funds-moving writes (Decision 0035). Every prepare, broadcast report, and
# Privy execute fails closed with CAPABILITY_UNAVAILABLE while this is false.
# Enabling it also requires a canary allowlist of canonical asset IDs and a
# per-intent USD ceiling; an intent whose value cannot be priced is never
# admitted. Mainnet outside the canary needs its own security decision.
BSC_WRITES_ENABLED=false
BSC_WRITE_CANARY_ASSETS=
BSC_WRITE_CANARY_MAX_USD=20
# Privy Swap platform-fee slot in bps; 0 sends no fee_configuration. The
# product value is still undecided.
LOOP_SWAP_FEE_BPS=0

# Worker lane that reads receipts and Privy action status for wallet intents.
# Default off; needs BSC_RPC_URLS, and PRIVY_APP_ID/SECRET for Swap status.
WALLET_INTENT_RECONCILE_ENABLED=false

# Worker lane that computes Mining Power snapshots (Decision 0036). Default
# off; even when on it is idle until a formula version is approved by
# `pnpm mining:approve-formula --confirm` (refused in production).
MINING_SNAPSHOT_ENABLED=false

# USD1 registry slot. Both keys are required before the configured address can
# enter the Asset Registry as `verified`; the address alone never earns it.
BSC_USD1_TOKEN_ADDRESS=
BSC_USD1_VERIFIED=false

# Native amount held back from spendableBalance so a later transfer or Swap can
# still pay gas. Decimal BNB, at most 18 fraction digits, at most 1 BNB. It is a
# display-side product policy published as gasReservePolicy.walletGasReserveV1,
# never a chain fact.
WALLET_GAS_RESERVE_BNB=0.005

# Default-off narrow BSC indexer lane in the standalone worker process. It
# indexes only ERC-20 Transfer logs of Asset Registry assets, never the whole
# chain, and requires BSC_RPC_URLS. BSC_INDEXER_START_BLOCK seeds a brand-new
# lane; blank starts one reorg depth behind the head.
BSC_INDEXER_ENABLED=false
BSC_INDEXER_START_BLOCK=

# Market Providers (Decision 0034). DexScreener needs no credential and is on
# by default (300 requests/minute documented; the throttle can only be
# lowered). GoPlus token-security facts need the key pair; without it every
# security fact and holder count is unavailable. GeckoTerminal (OHLCV, new
# pools) stays off until its commercial terms are verified. TTLs are seconds;
# a fact past its TTL is served as `stale` only inside the grace window and
# only when the Provider cannot be reached.
# The API and worker processes each get a per-minute budget; api + worker
# must not exceed 300, DexScreener's documented limit.
MARKET_PROVIDER_DEXSCREENER_ENABLED=true
MARKET_DEXSCREENER_BUDGET_API=120
MARKET_DEXSCREENER_BUDGET_WORKER=120
MARKET_PROVIDER_GECKOTERMINAL_ENABLED=false
MARKET_GECKOTERMINAL_RATE_LIMIT_PER_MINUTE=30
# Worker-process share of the same 30/min GeckoTerminal limit (Decision 0074);
# the API keeps MARKET_GECKOTERMINAL_RATE_LIMIT_PER_MINUTE. Both processes
# share one egress, so keep this small.
MARKET_GECKOTERMINAL_BUDGET_WORKER=10
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
MARKET_GOPLUS_RATE_LIMIT_PER_MINUTE=30
MARKET_PRICE_TTL_SECONDS=30
MARKET_SECURITY_TTL_SECONDS=600
MARKET_CANDLES_TTL_SECONDS=60
# Row sparkline cache row TTL (Decision 0074): the API publishes a row as
# fresh inside it, stale inside the grace window; the worker lane refreshes
# an asset once it is past it.
MARKET_SPARKLINE_TTL_SECONDS=300
MARKET_STALE_GRACE_SECONDS=900

# Default-on market sparkline warm lane in the standalone worker process
# (Decision 0074). It only runs with MARKET_PROVIDER_GECKOTERMINAL_ENABLED and
# refreshes at most one asset's 24 hourly closes per tick, skipping rows still
# inside MARKET_SPARKLINE_TTL_SECONDS; the overview reads those rows only.
MARKET_SPARKLINE_WARM_ENABLED=true
MARKET_SPARKLINE_WARM_INTERVAL_MS=4000

# Default-off alert evaluator lane in the standalone worker process. It reads
# only fresh DexScreener prices (requires MARKET_PROVIDER_DEXSCREENER_ENABLED),
# flips a satisfied V2 alert to `triggered`, and writes one context
# notification per alert per dedupe window. When the push channel below is
# configured it also pushes the trigger pointer to the owner's devices.
ALERT_EVALUATOR_ENABLED=false
ALERT_NOTIFICATION_DEDUPE_SECONDS=3600

# Community AI (Decision 0066, amended 2026-09-23). COMMUNITY_AI_BASE_URL is
# the Anthropic-compatible Provider origin: https only, no credentials, no
# path/query/fragment (the adapter appends /v1/messages). The Development
# stack points it at https://api.onlyrouter.ai. COMMUNITY_AI_API_KEY is the
# Provider key and takes precedence over ANTHROPIC_API_KEY; with neither set
# the communityAi capability stays deferred (COMMUNITY_AI_RUNTIME_DEFERRED)
# and no answer is ever produced. Never commit a real key.
COMMUNITY_AI_BASE_URL=https://api.anthropic.com
COMMUNITY_AI_API_KEY=
# COMMUNITY_AI_TIMEOUT_MS (default 11000) bounds the model call inside an ask
# request so it ends in a 503 before the 15 s HTTP deadlines. The background
# brief answers no request and has its own ceiling (default 30000, 5000-120000).
COMMUNITY_AI_BRIEF_TIMEOUT_MS=30000

# Push channel (Decision 0067). The path of the Firebase service-account JSON
# used for FCM HTTP v1; both Android and iOS are addressed through FCM, iOS via
# the APNs key uploaded in the Firebase console. This is a PATH, never the key:
# keep the file outside Git and outside any image layer. Blank keeps
# `pushNotifications` unavailable with PUSH_RUNTIME_DEFERRED, refuses
# POST /v2/devices/push-token, and leaves every producer feed-only.
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

# Passkey relying-party association files (Decision 0063). None of these is a
# secret; they are published verbatim at /.well-known. Without
# PASSKEY_ANDROID_CERT_SHA256 the assetlinks.json route answers 404, and
# without PASSKEY_IOS_TEAM_ID the apple-app-site-association route answers 404.
# Fingerprints are comma-separated, 32 colon-separated hex byte pairs each
# (`keytool -list -v -keystore <store>` prints them); add one per keystore that
# signs a build which must reach LOOP passkeys.
PASSKEY_ANDROID_PACKAGE=com.cywd.loop
PASSKEY_ANDROID_CERT_SHA256=
PASSKEY_IOS_TEAM_ID=
PASSKEY_IOS_BUNDLE_ID=com.cywd.loop

# Local-only credentials must match compose.yaml. Replace them outside local dev.
# The standalone reconciliation worker reads NODE_ENV, LOG_LEVEL, DATABASE_*,
# and the explicit reconciliation/quota settings above. It loads no Privy,
# wallet, signer, Exchange, relay, or provider-write credential.
DATABASE_URL=postgres://loop_api:loop_api_local_only@127.0.0.1:5432/loop_api_dev
# `pnpm test:integration` reads ONLY this variable and never falls back to
# DATABASE_URL. It must point at a separate, disposable database whose name
# contains `test` (the suites truncate tables). Create it once with
# `CREATE DATABASE loop_api_test OWNER loop_api;` and run `pnpm db:migrate:test`.
DATABASE_URL_TEST=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=5000
