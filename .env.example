# Safe local-development defaults. Copy to .env.local; never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
API_DOCS_ENABLED=true
TRUST_PROXY=false
LOG_LEVEL=info

# Decision 0147 revision S211: the public MEME surface (/public/*) rate limit
# per visitor per minute (10-10000, in process memory, per replica), and which
# forwarded headers name the visitor when TRUST_PROXY=true (in order; "none"
# keeps request.ip). Only list a header every path to the API overwrites.
PUBLIC_RATE_LIMIT_PER_MINUTE=120
PUBLIC_CLIENT_IP_HEADERS=x-forwarded-for

# LOOP v2 session/account slice. It defaults off in NODE_ENV=production and
# still requires working Privy credentials plus the current database migration.
V2_SESSION_ENABLED=true

# V2 client policy gates (Decision 0029). Every gate stays "unavailable" until
# its complete policy is configured; a partial version policy fails startup.
# Minimum versions are SemVer 2.0 and store URLs must be https without
# credentials. All four keys below are required together.
V2_CLIENT_POLICY_MIN_VERSION_IOS=
V2_CLIENT_POLICY_MIN_VERSION_ANDROID=
V2_CLIENT_POLICY_STORE_URL_IOS=
V2_CLIENT_POLICY_STORE_URL_ANDROID=

# Optional hard floors. A client below this version must update before it can
# continue; between this and the minimum it sees a dismissible prompt. Must not
# exceed the platform minimum; blank means the hard floor equals the minimum.
V2_CLIENT_POLICY_FORCE_UPDATE_BELOW_IOS=
V2_CLIENT_POLICY_FORCE_UPDATE_BELOW_ANDROID=

# Policy snapshot identity. Blank keeps the compiled product baseline, but as
# soon as any version or terms gate above/below is configured BOTH keys are
# required (startup fails otherwise). EFFECTIVE_AT is RFC 3339 with an explicit
# timezone, e.g. 2026-09-07T00:00:00Z; while it is still in the future every
# configured gate reports "unavailable" with reasonCode POLICY_NOT_YET_EFFECTIVE.
V2_CLIENT_POLICY_CONFIG_VERSION=
V2_CLIENT_POLICY_EFFECTIVE_AT=

# Terms gate: the terms version every client must present as accepted. Blank
# keeps the gate unavailable.
V2_TERMS_REQUIRED_VERSION=

# V2 module gate: comma-separated set of module IDs whose routes may register.
# Allowed: community,communication,search,market,chain,wallet,swap,
# sendApprovals,launch,mining,referral,notifications,profile,watchlist. Blank
# enables none. "profile" (Decision 0030), "community"/"search" (0031),
# "communication" (0032), "chain"/"wallet"/"watchlist" (0033),
# "market"/"notifications" (0034), "swap"/"sendApprovals" (0035), and
# "launch"/"mining"/"referral" (0036) are delivered.
V2_MODULES_ENABLED=

# Optional comma-separated alias blocklist for V2 profile writes. Each term is
# NFKC-normalised and lower-cased, then matched as a substring of the
# normalised alias; a hit returns ALIAS_BLOCKED. Reserved staff/system words
# (loop, admin, official, support, system, mod, moderator, team) are compiled.
V2_ALIAS_BLOCKED_TERMS=

# Independent server-only HMAC key for owner/route/filter-bound V2 list
# cursors. Generate at least 32 random bytes outside Git. Never commit it.
V2_CURSOR_HMAC_SECRET=

# Leave blank until configured in the Privy dashboard. Never commit real values.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# The reviewed v0.7.63 license gate is accepted. Configure only a Development
# Stream App outside Git. Chat and Video share it. Never commit the API secret.
STREAM_API_KEY=
STREAM_API_SECRET=

# Server-only HMAC key for domain-separated Stream-token and alias-search quotas.
# Generate at least 32 random bytes outside Git; raw users and IPs are never stored.
STREAM_TOKEN_QUOTA_HMAC_SECRET=
STREAM_TOKEN_USER_LIMIT_PER_MINUTE=10
STREAM_TOKEN_IP_LIMIT_PER_MINUTE=60

# Audio-room role evidence switch (Decision 0039). Blank keeps
# voiceRooms.evidence pending (AUDIO_ROOM_USER_ROLE_EVIDENCE_PENDING) and the
# mobile voice-room page unavailable. Set it only after archiving a Stream
# Dashboard screenshot that shows, for BOTH the audio_room call type and the
# Global video permissions, the `user` role with Create call = Not allowed,
# Read/Join allowed, Update/End = own only, Delete = Not allowed. The value is
# the archive label of that screenshot (for example
# dashboard-2026-09-10-user-role-no-create-call): 1-120 printable characters,
# no control characters, no URL with credentials, no secret. It is published
# verbatim as voiceRooms.evidence.reference and logged once at startup; the
# screenshot itself stays outside Git wherever operations archives it.
STREAM_AUDIO_ROOM_USER_ROLE_EVIDENCE_REF=

# Independent server-only keys for encrypted, owner-bound social cursors and
# privacy-preserving friend-mutation quotas. Configure both or neither.
SOCIAL_CURSOR_HMAC_SECRET=
SOCIAL_QUOTA_HMAC_SECRET=

# Independent server-only HMAC key for owner/wallet/route-bound Perp read cursors.
# Required only when enabling private reads. Never commit the real value.
PERP_READ_CURSOR_HMAC_SECRET=

# Hyperliquid private reads are default-off and fixed to Testnet/Core.
# Enabling requires Privy credentials, the cursor key above, and a separate
# server-only quota HMAC key. The internal limit stays below provider 1200/min.
HYPERLIQUID_PRIVATE_READS_ENABLED=false
HYPERLIQUID_INFO_QUOTA_HMAC_SECRET=
HYPERLIQUID_INFO_WEIGHT_LIMIT_PER_MINUTE=960

# The standalone worker keeps the retained Perp reader behind its own
# default-off switch. It reuses the global Info quota, performs Testnet reads
# only, and never submits or replays provider writes. API/worker replicas
# sharing one egress must also share this quota secret and capacity.
HYPERLIQUID_RECONCILIATION_READS_ENABLED=false

# Independent default-off gate for the Spot intent lane. It shares that same
# global Info quota but does not enable or depend on Perp reconciliation.
HYPERLIQUID_SPOT_RECONCILIATION_READS_ENABLED=false

# Database-only safety maintenance. This expires elapsed signing handoffs and
# retires elapsed Testnet Spot Agent generations. It never calls Privy or
# Hyperliquid and can be disabled temporarily for operator maintenance.
SPOT_AGENT_LIFECYCLE_MAINTENANCE_ENABLED=true

# Database-only cleanup for expired issuance quota windows. The seven-day
# post-window retention policy is compiled and cannot be shortened here. This
# switch exists only to pause cleanup during explicit database maintenance.
ISSUANCE_RATE_RECORD_CLEANUP_ENABLED=true

# BSC read endpoints: a comma-separated list of http(s) RPC URLs (production
# should configure at least two). Blank leaves every chain read closed and
# reports bscRead as unavailable with BSC_RPC_NOT_CONFIGURED. The endpoint's
# eth_chainId must equal 56; a mismatch stays unavailable with
# BSC_CHAIN_ID_MISMATCH and logs a startup warning instead of crashing. Note
# that some public endpoints refuse eth_getLogs entirely, which the indexer
# lane needs. Endpoint URLs are never published in an API response.
BSC_RPC_URLS=
BSC_CONFIRMATIONS=15
BSC_REORG_DEPTH_BLOCKS=64

# Launch chain slot (Decision 0038). The primary chain above is always
# eip155:56; only the Launch module may point at another chain. 56 (default)
# reuses BSC_RPC_URLS/BSC_CONFIRMATIONS/BSC_REORG_DEPTH_BLOCKS and every
# LAUNCH_BSC_* key must stay blank (startup fails otherwise). 97 is the BSC
# testnet: LAUNCH_BSC_RPC_URLS is its own comma-separated http(s) list (blank
# keeps the slot unavailable with LAUNCH_CHAIN_RPC_NOT_CONFIGURED, never a
# crash); confirmations default to 5 and reorg depth to 15. The endpoint's
# eth_chainId must equal the configured value or the slot reports
# LAUNCH_CHAIN_ID_MISMATCH. Wallet, market, Swap, approvals, and the indexer
# stay on the primary chain regardless of this slot. URLs are never published.
LAUNCH_CHAIN_ID=56
LAUNCH_BSC_RPC_URLS=
LAUNCH_BSC_CONFIRMATIONS=
LAUNCH_BSC_REORG_DEPTH_BLOCKS=

# Decision 0150: the BSC Mainnet switch of the launch slot. Blank (default)
# keeps LAUNCH_CHAIN_ID=56 exactly as before: the Hooks Factory, official-pool
# router and LoopDynamic Factory / Router keys refuse boot, every server-signed
# write lane (Hooks executor, snapshot publisher, buyback keeper, poke keeper)
# refuses boot, and the launch2 / Mining claim prepares answer
# LAUNCH2_MAINNET_SIGNING_CLOSED / MINING_CLAIM_MAINNET_CLOSED. Only the exact
# phrase I_UNDERSTAND_THIS_IS_BSC_MAINNET_WITH_REAL_FUNDS opens them on 56; any
# other non-blank value, or the phrase with LAUNCH_CHAIN_ID=97, refuses boot.
# Each write lane still needs its own switch AND BSC_WRITES_ENABLED=true (read by
# the worker too); the executor / buyback keeper / poke keeper also need
# CHAIN_GUARD_ENABLED=true on 56. The testnet faucet and the MEME v1 curve stay
# closed on 56 regardless. Not a secret.
LAUNCH_MAINNET_ACK=

# Launch contract on the launch slot (Decision 0076). All four blank keeps
# every Launch chain fact unavailable (LAUNCH_CONTRACT_BASELINE_PENDING) and
# every response unchanged. All four set enables the read-only adapter;
# setting only some of them refuses to boot. LAUNCH_CONTRACT_VERSION is the
# contract's semantic version (the adapter speaks ABI major 1; another major
# is LAUNCH_CONTRACT_VERSION_UNSUPPORTED). LAUNCH_CONTRACT_START_BLOCK is the
# deployment block. At startup one eth_getCode must see code at the address,
# otherwise LAUNCH_CONTRACT_CODE_MISSING (the API still starts).
LAUNCH_CONTRACT_ADDRESS=
LAUNCH_CONTRACT_VERSION=
LAUNCH_CONTRACT_START_BLOCK=
LAUNCH_USD1_ADDRESS=
# Decision 0085 (API only): how long, in milliseconds, one successful sale
# snapshot (four axes + rounds + config at one block) is reused in memory by
# GET /v2/launches/{id} and the eligibility read. Default 1500 (about half a
# BSC block interval); 0 disables it. Never shared across processes.
LAUNCH_SNAPSHOT_CACHE_TTL_MS=1500

# MEME curve launchpad (Decision 0101) on the same launch slot; the quote
# asset is LAUNCH_USD1_ADDRESS above. Any of the four contract keys blank keeps
# the `meme` capability unavailable (MEME_CONTRACT_NOT_CONFIGURED) and every
# /v2/meme/* route 503; a malformed value refuses boot. The startup probe must
# see code, params() equal to docs/10 and this USD1, and tokenImplementation()
# equal to MEME_TOKEN_IMPLEMENTATION (else MEME_CONTRACT_PARAMS_MISMATCH).
MEME_CONTRACT_ADDRESS=
MEME_CONTRACT_VERSION=
MEME_CONTRACT_START_BLOCK=
MEME_TOKEN_IMPLEMENTATION=
# Free CREATE2 salts the pool keeps (0-1000), the hex address suffix they are
# mined for (0-8 chars; empty = no vanity), drafts per account per rolling 24 h.
MEME_SALT_POOL_TARGET=50
MEME_VANITY_SUFFIX=6666
MEME_CREATE_DAILY_LIMIT=3
# Decision 0151: classic launch creation (POST /v2/meme/tokens and create
# Intents) answers 410 MEME_CLASSIC_LAUNCH_RETIRED unless true. Default false;
# set true only to demo the old flow. Reads, buy / sell, reports unaffected.
MEME_CLASSIC_CREATE_ENABLED=false
# Both default false: MEME_INDEXER_ENABLED (worker) runs the meme_event lane,
# the salt pool, and the Intent receipt reconcile;
# MEME_GRADUATION_EXECUTOR_ENABLED signs graduate(token) for curves full for
# MEME_GRADUATION_DELAY_SECONDS (default 15, 0-600; Decision 0103) with
# LAUNCH_DEPLOYER_PRIVATE_KEY (testnet 97 only; boot is refused without a
# 32-byte hex key). Never commit the key. Worker only: the API process no
# longer reads either key (Decision 0105).
MEME_INDEXER_ENABLED=false
MEME_GRADUATION_EXECUTOR_ENABLED=false
MEME_GRADUATION_DELAY_SECONDS=15
LAUNCH_DEPLOYER_PRIVATE_KEY=

# Decision 0108 / 0112: Hooks launch (BSC Testnet 97; on 56 only with
# LAUNCH_MAINNET_ACK, Decision 0150, where every "LAUNCH_CHAIN_ID=97" rule
# below reads "97, or 56 with the ack"). The API routes are
# behind HOOKS_LAUNCH_ENABLED; signing and submission also need the Factory
# address + runtime code hash (both or neither). The worker's deployment
# executor (default off) signs deployLaunch / activateLaunch with its own key:
# `on` refuses boot without a 32-byte hex key, the Factory pair, or
# LAUNCH_CHAIN_ID=97. The key's address must be the Factory's
# deploymentExecutor. Never commit the key.
HOOKS_LAUNCH_ENABLED=off
HOOKS_LAUNCH_FACTORY_ADDRESS=
HOOKS_LAUNCH_FACTORY_CODE_HASH=
# Decision 0117: minimum lead (seconds) between now and a saved config's
# nftSaleStartAt, on both the owner PUT and the operator save path. Default
# 86400 (production). Floor 4200 = the Gate's 3600 s activation buffer + 600 s
# for the executor to deploy, confirm, verify and activate; ceiling 2592000.
# Development / BSC Testnet may use 4200 for same-day NFT sales.
HOOKS_LAUNCH_MIN_SALE_LEAD_SECONDS=86400
# Decision 0122 (requirer ruling 9): the one buyback recipient every Hooks
# config must name (API process). A save / signing request / submission naming
# another address is 422 VALIDATION_FAILED (HOOKS_BUYBACK_RECIPIENT_FIXED);
# blank keeps them 503 HOOKS_BUYBACK_RECIPIENT_UNAVAILABLE. GET hooks-config
# shows it read-only (fixedBuybackRecipient). Development / BSC Testnet:
# 0x28816c4C4792467390C90e5B426F198570E29307.
LAUNCH2_BUYBACK_RECIPIENT=
HOOKS_LAUNCH_EXECUTOR_ENABLED=off
HOOKS_LAUNCH_EXECUTOR_PRIVATE_KEY=
HOOKS_LAUNCH_EXECUTOR_CONFIRMATIONS=3
HOOKS_LAUNCH_EXECUTOR_POLL_INTERVAL_MS=5000
HOOKS_LAUNCH_EXECUTOR_LEASE_SECONDS=120
HOOKS_LAUNCH_EXECUTOR_MAX_ATTEMPTS=3
HOOKS_LAUNCH_EXECUTOR_RETRY_DELAY_SECONDS=60
HOOKS_LAUNCH_EXECUTOR_GAS_LIMIT_CAP=16000000
HOOKS_LAUNCH_EXECUTOR_MAX_GAS_PRICE_GWEI=20

# Decision 0114: MEME v2 (`launch2`) read model. The /v2/launch2/* routes need
# `launch2` in V2_MODULES_ENABLED plus the Hooks Factory pair above on the
# BSC Testnet launch slot; prepares also need BSC_WRITES_ENABLED. The worker's
# launch2_event lane (default off) indexes every activated S132 task.
LAUNCH2_QUOTE_TTL_SECONDS=60
LAUNCH2_DEFAULT_SLIPPAGE_BPS=100
# Decision 0126: the on-chain deadline a curve / pool prepare encodes, from the
# prepare (the device signs the approve and then the trade). 60..600, default 180.
# The quote TTL above stays the quote's freshness.
LAUNCH2_POOL_TRADE_DEADLINE_SECONDS=180
# Decision 0166: off|on (default off; any other value refuses boot). off omits
# the trader `account` key (Decision 0162) from GET /v2/launch2/instances/{id}
# recentTrades, .../pool/trades and GET /v2/launch2/overview activity, and
# skips the wallet -> account lookup. Older apps (build <= 30) decode those
# objects strictly and fail the whole page on the extra key; turn on only once
# every supported client (build >= 31) decodes `account` as an optional key.
LAUNCH2_TRADER_ACCOUNT_EMIT=off
# Decision 0173: off|on (default off). off omits the optional `nftImageUrl`
# key (project NFT picture) from GET /v2/launch2/instances, .../instances/{id}
# and GET /v2/launch2/me/positions; on emits it (null when the project has
# none). Turn on only once every supported client decodes the key.
LAUNCH2_NFT_IMAGE_EMIT=off
# Decision 0174: off|on (default off). off omits the optional priceUsd1 /
# valueUsd1 / priceSource keys from GET /v2/launch2/me/positions rows; on
# emits them (null when the instance has no price). Turn on only once every
# supported client decodes the keys.
LAUNCH2_POSITION_VALUE_EMIT=off
# Decision 0176: off|on (default off). off omits the optional avgCostUsd1 /
# costBasisUsd1 / realizedPnlUsd1 / unrealizedPnlUsd1 / costCoverage keys from
# GET /v2/launch2/me/positions rows and the instance detail's viewer; on emits
# them (null when the wallet has no trade). Turn on only once every supported
# client decodes the keys.
LAUNCH2_PNL_EMIT=off
# Decision 0173: project NFT pictures (POST /v2/media/project-nft-images).
# local (default) stores them like other media; filebase also pins them to IPFS
# through the Filebase IPFS RPC API and then needs FILEBASE_RPC_ENDPOINT and
# FILEBASE_RPC_TOKEN (a secret: keep it in the untracked env file only).
NFT_IMAGE_STORAGE=local
FILEBASE_RPC_ENDPOINT=
FILEBASE_RPC_TOKEN=
IPFS_GATEWAY_BASE_URL=https://ipfs.filebase.io/ipfs
# Decision 0166: off|on (default off). off keeps GET /v2/referral in its
# pre-0162 shape (no inviteLink / stats keys, boost always unavailable
# MINING_REFERRAL_BOOST_PENDING) for build <= 30 strict decoders; on emits
# them. Turn on only once every supported client (build >= 31) decodes them.
REFERRAL_CENTER_EMIT=off
# Decision 0167: off|on (default off). off keeps
# GET /v2/wallets/{walletId}/activity byte-identical (primary-chain ERC-20
# rows only). on merges the wallet's MEME v2 (launch2) activity on the Launch
# chain into the same list (new row shape + `launch2` block, a new cursor).
# Turn on only once every supported client (build >= 32) decodes them.
WALLET_ACTIVITY_LAUNCH2_EMIT=off
# Decision 0169: off|on (default off). off keeps
# GET /v2/profiles/{id}/holdings and /trades byte-identical (primary chain
# only). on mixes the owner's MEME v2 (launch2) holdings / activity on the
# Launch chain into `items` (new row shapes + optional `launch2` block; trades
# get a new cursor). Turn on only once every supported client (build >= 34)
# decodes them.
PROFILE_LAUNCH2_EMIT=off
# Decision 0175: off|on (default off). off keeps every /v2 community
# projection (community summary, search community results, profile
# communities) byte-identical; on adds the optional `label` key (the
# operator-set custom community label, string or null). Turn on only once
# every supported client decodes the key.
COMMUNITY_LABEL_EMIT=off
# Decision 0186: off|on (default off). off keeps the market list rows
# (GET /v2/market/assets?category= items, overview watchlist / trending
# items) byte-identical; on adds the optional `sparkline24h` key (up to 24
# hourly closes as decimal strings, or null). Turn on only once every
# supported client decodes the key.
MARKET_ROW_SPARKLINE24H_EMIT=off
# Decision 0177: off|on (default off), read by both the API and the worker.
# The four fine inbox events (launch.graduated, launch.badge_minted,
# social.friend_request, social.friend_accepted) are always written; off
# hides them from GET /v2/notifications/feed (items and unreadCount),
# GET /v2/notifications/unread-count, POST /v2/notifications/read-all and
# the single read, and the worker sends no push for them. Turn on only once
# every supported client decodes the new feed `type` values.
NOTIFICATION_INBOX_EMIT=off
# Decision 0178: off|on (default off), read by both the API and the worker.
# The project owner's four launch progress events (launch.review_approved,
# launch.review_rejected, launch.activated, launch.deploy_failed; category
# launch.round) are always written; off hides them from
# GET /v2/notifications/feed (items and unreadCount),
# GET /v2/notifications/unread-count, POST /v2/notifications/read-all and the
# single read, and the worker's notification_inbox lane sends no push for
# them. Independent of NOTIFICATION_INBOX_EMIT. Turn on (API and worker
# together) only once every supported client decodes the four feed `type`
# values and has the push.launchReviewApproved / launchReviewRejected /
# launchActivated / launchDeployFailed localization keys.
LAUNCH_REVIEW_INBOX_EMIT=off
# Decision 0124: official-pool (Uniswap v4) trading after graduation goes
# through OfficialPoolRouter. Address + runtime code hash are one unit (BSC
# Testnet only; checked at startup and before every pool quote / prepare).
# Blank = /v2/launch2/instances/{id}/pool/* answer 503 POOL_ROUTER_NOT_CONFIGURED.
# Decision 0126: the worker reads the same pair; with it the launch2_event lane
# attributes pool swaps to wallets from the router's Swap(payer) logs.
# BSC Testnet (loop-contracts protocol/deployments/bsc-testnet/pool-router.json):
#   0xcb022501A427154501aDcE5b6dC8f16674aE8f5D
#   0x94392c12b59acc4cd9f2fce6b139289ea166cb96bc91d54fe1d38a978399e118
LAUNCH2_POOL_ROUTER_ADDRESS=
LAUNCH2_POOL_ROUTER_CODE_HASH=
LAUNCH2_INDEXER_ENABLED=false
LAUNCH2_INDEXER_POLL_INTERVAL_MS=3000
# Decision 0122: older Factories the launch2_event lane keeps indexing
# read-only beside HOOKS_LAUNCH_FACTORY_ADDRESS (which is always the current,
# v3 generation: no buyback price protection, zero-holder public opening).
# Comma-separated <generation>:<address>; generations v2 (price-protected
# buyback, BuybackCompleted with minMemeOut/referencePrice/spotPrice) and v3.
# Malformed, duplicated, or equal to the current Factory refuses worker boot.
# BSC Testnet after the switch to the third Factory:
# LAUNCH2_LEGACY_FACTORIES=v2:0x6A69bA7a5A71C114301E20eF95f62Cd83d07D9c0
LAUNCH2_LEGACY_FACTORIES=

# Decision 0118: the worker's launch2_snapshot_publisher lane (default off)
# signs each instance's NFT-holder snapshot with 2 of the 3 snapshot signer
# keys registered in the Factory and submits SnapshotRegistry.publishSnapshot.
# Decision 0122: a v3 instance whose sale ended with totalMinted() = 0 is
# opened instead (SnapshotRegistry.openPublicWithoutSnapshot() from the
# submitter account, same record-first / nonce-lock / confirmations rules);
# v2 instances are still closed (closed_no_holders).
# `true` refuses boot without 2-3 distinct comma-separated 32-byte hex signer
# keys, without a submitter key (LAUNCH2_SNAPSHOT_SUBMITTER_PRIVATE_KEY, else
# the HOOKS_LAUNCH_EXECUTOR_PRIVATE_KEY account is reused), or off
# LAUNCH_CHAIN_ID=97. It needs the launch2_event lane running (it waits for its
# checkpoint). Testnet: signer 0 / 1 keys from ops/protocol-testnet.local.env.
# Mainnet custody is undecided. Never commit keys.
LAUNCH2_SNAPSHOT_PUBLISHER_ENABLED=false
LAUNCH2_SNAPSHOT_SIGNER_PRIVATE_KEYS=
LAUNCH2_SNAPSHOT_SUBMITTER_PRIVATE_KEY=
LAUNCH2_SNAPSHOT_PUBLISHER_POLL_INTERVAL_MS=5000
LAUNCH2_SNAPSHOT_PUBLISHER_CONFIRMATIONS=12
LAUNCH2_SNAPSHOT_PUBLISHER_MAX_GAS_PRICE_GWEI=20

# Decision 0121: the worker's launch2_buyback_keeper lane (default off) calls
# BuybackExecutor.execute() on graduated, unpaused launch2 instances (one order
# = min(escrow budget, 100 USD1), >= 10 s between successes, locked-principal
# guard; Decision 0122: no price protection on the v3 Factory, v2 instances
# keep theirs). Each tick simulates first: a refusal (principal guard,
# interval, budget, pause, not a keeper; v2 price protection) is recorded with backoff and nothing
# is sent; a passing simulation is recorded, then signed (nonce reserved under
# the account lock shared with the Hooks executor / snapshot publisher), then
# sent. The ledger stays the launch2_event lane's (BuybackCompleted).
# `true` refuses boot without a 32-byte hex key, without
# HOOKS_LAUNCH_FACTORY_ADDRESS, off LAUNCH_CHAIN_ID=97, or with an interval
# under 10 s; the worker then reads the Factory's primaryKeeper() /
# fallbackKeeper() and refuses boot when the key is neither. Testnet: the
# LOOP_PRIMARY_KEEPER_PRIVATE_KEY account (needs tBNB). Never commit keys.
LAUNCH2_BUYBACK_KEEPER_ENABLED=false
LAUNCH2_BUYBACK_KEEPER_PRIVATE_KEY=
LAUNCH2_BUYBACK_KEEPER_INTERVAL_SECONDS=15
LAUNCH2_BUYBACK_KEEPER_CONFIRMATIONS=12

# Decision 0131 (S166): the optional LoopDynamic official-pool Hook kind
# (loop-contracts S164 + S165, Decision 0009). Everything below defaults off;
# the OfficialTax path is unchanged.
# HOOKS_LAUNCH_HOOK_KIND (API + worker): the Hook kind of NEW Hooks launches.
# Decision 0132: loopDynamic saves / reviews / signs (API) and deploys /
# verifies / activates (worker executor) on LAUNCH2_DYNAMIC_FACTORY_* below;
# without that pair saves are 503 and the executor refuses boot. The executor
# then only advances tasks signed for the LoopDynamic Factory.
HOOKS_LAUNCH_HOOK_KIND=officialTax
# API: the shared LoopRouter (exact-input router of every LoopDynamic pool) and
# its runtime code hash, one unit, BSC Testnet only. Blank = LoopDynamic
# quotes / prepares / dynamic-pool reads answer 503
# LAUNCH2_DYNAMIC_ROUTER_NOT_CONFIGURED. Manifest: loopDynamic.loopRouter /
# loopDynamic.loopRouterCodeHash (VerifyLoopProtocol).
LAUNCH2_DYNAMIC_ROUTER_ADDRESS=
LAUNCH2_DYNAMIC_ROUTER_CODE_HASH=
# API, optional: the trusted-router list of the current LoopDynamic Factory
# (manifest loopDynamic.loopRouterRegistry). Decision 0153: every Hook is
# checked against its own Factory's loopRouter() / routerRegistry() (read
# from the chain); for the current Factory those must equal
# LAUNCH2_DYNAMIC_ROUTER_ADDRESS / this value, else 503
# LAUNCH2_DYNAMIC_ROUTER_MISMATCH. The API also reads LAUNCH2_LEGACY_FACTORIES:
# its v3 entries are the older LoopDynamic Factories whose instances stay
# readable / tradable through their own (older) LoopRouter; any other
# Factory's instance is 503 LAUNCH2_DYNAMIC_FACTORY_UNKNOWN.
LAUNCH2_DYNAMIC_ROUTER_REGISTRY_ADDRESS=
# API, optional (Decision 0153): further accepted LoopRouter runtime code
# hashes for older Factories' routers, comma-separated (the runtime code
# embeds the PoolManager, so a router on another PoolManager hashes
# differently). Blank = only LAUNCH2_DYNAMIC_ROUTER_CODE_HASH.
LAUNCH2_DYNAMIC_LEGACY_ROUTER_CODE_HASHES=
# API + worker: the LoopDynamic Factory (manifest loopDynamic.launchFactory /
# launchFactoryCodeHash); one unit, BSC Testnet only. Blank = none. Worker:
# the launch2_event lane indexes it beside HOOKS_LAUNCH_FACTORY_ADDRESS, and
# with HOOKS_LAUNCH_HOOK_KIND=loopDynamic the executor targets it (code hash
# checked every tick, template re-verified on chain). API: the target of new
# Hooks configs / signatures with HOOKS_LAUNCH_HOOK_KIND=loopDynamic.
LAUNCH2_DYNAMIC_FACTORY_ADDRESS=
LAUNCH2_DYNAMIC_FACTORY_CODE_HASH=
# Worker: the poke() keeper. Every interval it calls the permissionless
# LoopDynamicHook.poke() once for each armed Hook whose 5-minute candle ended
# without a swap (simulated first). Any funded testnet key; never the
# deployer / executor keys. `true` refuses boot without a 32-byte hex key or
# off LAUNCH_CHAIN_ID=97. Interval 15..3600 s, default 60.
LAUNCH2_DYNAMIC_POKE_ENABLED=false
LAUNCH2_DYNAMIC_POKE_PRIVATE_KEY=
LAUNCH2_DYNAMIC_POKE_INTERVAL_SECONDS=60

# Decision 0134: the read-only chain_guard worker lane (default off) and
# `pnpm chain:preflight`. Reads USD1 paused()/frozen()/implementation, the
# v4 protocol fee controller and pool fees, and signer BNB balances on the
# launch slot; an unresolved USD1 pause / freeze of one of our addresses
# holds the buyback keeper, Hooks executor, and poke keeper (CHAIN_GUARD_HOLD).
# Every key is optional; malformed refuses boot. Lists are label:0x-address.
CHAIN_GUARD_ENABLED=false
CHAIN_GUARD_INTERVAL_SECONDS=60
# Else LAUNCH_USD1_ADDRESS, else the Factory's usd1().
CHAIN_GUARD_USD1_ADDRESS=
# Mainnet: 0x694Aa534bdef8eD63244eB902E7914e527891F08 (docs/24 §7.5).
CHAIN_GUARD_USD1_IMPLEMENTATION=
# Before a Factory exists; mainnet 0x28e2Ea090877bF75740558f6BFB36A5ffeE9e9dF.
CHAIN_GUARD_POOL_MANAGER_ADDRESS=
# Mainnet reading 2026-10-14: 0x66276d2e80784180e4b9b859e4327b9c5646b87c.
CHAIN_GUARD_PROTOCOL_FEE_CONTROLLER=
CHAIN_GUARD_PROTOCOL_FEE_ALERT_PIPS=500
CHAIN_GUARD_MIN_BNB=0.05
CHAIN_GUARD_WATCH_ADDRESSES=
CHAIN_GUARD_BALANCE_ACCOUNTS=

# Decision 0105: the operator console's MEME pause/unpause signs with its own
# key (API process only, testnet 97 only), never the deployer key above, so
# the two never race for one nonce. Blank = pause/unpause unavailable
# (MEME_OPERATOR_KEY_MISSING); malformed refuses boot. The curve is Ownable:
# its owner must be this key's address (transferOwnership from the current
# owner, then acceptOwnership signed by this key) and it needs tBNB for gas.
# Never commit the key.
MEME_OPERATOR_PRIVATE_KEY=

# Decision 0128: testnet faucet (GET/POST /v2/testnet/faucet). The API signs a
# tBNB transfer and MockUSD1.mint(address, amount) to the caller's embedded
# wallet, once per wallet address per cooldown. true with LAUNCH_CHAIN_ID≠97
# refuses boot (not bound to NODE_ENV: staging is production on chain 97).
# USD1 (S156b): TESTNET_FAUCET_USD1_ADDRESS, else the Hooks Factory's usd1()
# (HOOKS_LAUNCH_FACTORY_ADDRESS, the MEME v2 USD1), else LAUNCH_USD1_ADDRESS.
# The RPC is LAUNCH_BSC_RPC_URLS. A blank key falls
# back to MEME_OPERATOR_PRIVATE_KEY; the account needs tBNB. Never commit it.
TESTNET_FAUCET_ENABLED=false
TESTNET_FAUCET_BNB_AMOUNT=0.02
TESTNET_FAUCET_USD1_AMOUNT=500
TESTNET_FAUCET_COOLDOWN_SECONDS=86400
TESTNET_FAUCET_OPERATOR_PRIVATE_KEY=
TESTNET_FAUCET_USD1_ADDRESS=
# S169 (Decision 0128 §9): with the fallback key and the console's MEME pause
# signer in this process, keep this much tBNB for pause gas; global per-UTC-day
# caps (503 TESTNET_FAUCET_DAILY_LIMIT); cooldown after a failed attempt (5
# failures per owner per UTC day → 429 until midnight); the worker lane
# testnet_faucet_pending_sweep closes grants still pending after the timeout
# (the worker reads TESTNET_FAUCET_ENABLED and the timeout too).
TESTNET_FAUCET_OPERATOR_RESERVE_BNB=0.05
TESTNET_FAUCET_DAILY_MAX_GRANTS=200
TESTNET_FAUCET_DAILY_MAX_BNB=2
TESTNET_FAUCET_FAILED_COOLDOWN_SECONDS=300
TESTNET_FAUCET_PENDING_TIMEOUT_SECONDS=900

# Decision 0095: comma-separated verified community UUIDs for the onboarding
# page (first five pre-selected). Decision 0102: the operator console's saved
# list overrides it; this stays the fallback.
RECOMMENDED_COMMUNITY_IDS=

# Decision 0105: comma-separated lower-case host names an intel promotion
# imageUrl (https, at most 512 characters) may use. Blank = every imageUrl
# must be null; a stored URL whose host is removed is served as null.
INTEL_PROMOTION_IMAGE_HOSTS=

# Decision 0102: operator console management surface (/admin/v1). All three or
# the surface is not mounted (404). The hash comes from
#   pnpm admin:hash-password
# (argon2id PHC string; keep the single quotes, it contains `$`). The session
# secret is 32+ random characters, e.g. `openssl rand -base64 48`. Never commit
# real values.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Decision 0110: console login lock, counted in PostgreSQL
# (admin_login_attempts) and shared by every instance. Per login name
# (case-insensitive): this many failures in a row lock the name for
# ..._LOCK_SECONDS. Per client address (IPv6 by /64): this many failures in
# the window lock the address. Defaults shown.
ADMIN_LOGIN_USERNAME_MAX_FAILURES=5
ADMIN_LOGIN_USERNAME_LOCK_SECONDS=900
ADMIN_LOGIN_IP_MAX_FAILURES=50
ADMIN_LOGIN_IP_WINDOW_SECONDS=900
ADMIN_LOGIN_IP_LOCK_SECONDS=900

# Decision 0077 S83b7b: off|on (default off; any other value refuses boot).
# off keeps GET /v2/launch/overview `graduated` byte-identical to before
# (unavailable LAUNCH_CONTRACT_BASELINE_PENDING even with a contract
# configured), for clients that only decode that branch. on publishes the
# available list of LP_LOCKED / COMPLETED sales. Turn on only once every
# supported client build decodes the new branch.
LAUNCH_GRADUATED_LIST=off

# Funds-moving writes (Decision 0035). Every prepare, broadcast report, and
# Privy execute fails closed with CAPABILITY_UNAVAILABLE while this is false.
# Enabling it also requires a canary allowlist of canonical asset IDs and a
# per-intent USD ceiling; an intent whose value cannot be priced is never
# admitted. Mainnet outside the canary needs its own security decision.
BSC_WRITES_ENABLED=false
BSC_WRITE_CANARY_ASSETS=
BSC_WRITE_CANARY_MAX_USD=20
# Privy Swap platform-fee slot in bps; 0 sends no fee_configuration. The
# product value is still undecided.
LOOP_SWAP_FEE_BPS=0

# Worker lane that reads receipts and Privy action status for wallet intents.
# Default off; needs BSC_RPC_URLS, and PRIVY_APP_ID/SECRET for Swap status.
WALLET_INTENT_RECONCILE_ENABLED=false

# Worker lane that computes Mining Power snapshots (Decision 0036). Default
# off; even when on it is idle until a formula version is approved by
# `pnpm mining:approve-formula --confirm` (refused in production).
MINING_SNAPSHOT_ENABLED=false

# Hourly two-track settlement (Decision 0116). The worker lane is default off
# and idle until a reviewer approves a mining parameter version. The claim
# routes stay 503 until the LoopRewardClaim address and the voucher signer
# key are set (the key is a secret: never commit it). USDT is only read to
# suggest a USDT -> BNB swap when the wallet cannot pay claim gas.
MINING_SETTLEMENT_ENABLED=false
MINING_SETTLEMENT_POLL_INTERVAL_MS=60000
MINING_SETTLEMENT_CATCHUP_HOURS=48
MINING_SETTLEMENT_INDEXER_GRACE_SECONDS=120
# Decision 0184: true narrows Mining Power (hourly settlement attribution and
# snapshot balance inputs) to LOOP embedded wallets. Default false: embedded
# and linked external wallets both count, pending the requester's answer.
MINING_EMBEDDED_WALLET_ONLY=false
MINING_SETTLEMENT_TEST_TRIGGER=false
MINING_REWARD_CLAIM_ADDRESS=
MINING_REWARD_SIGNER_PRIVATE_KEY=
MINING_CLAIM_CONFIRMATIONS=3
MINING_CLAIM_USDT_ADDRESS=

# USD1 registry slot. Both keys are required before the configured address can
# enter the Asset Registry as `verified`; the address alone never earns it.
BSC_USD1_TOKEN_ADDRESS=
BSC_USD1_VERIFIED=false

# Native amount held back from spendableBalance so a later transfer or Swap can
# still pay gas. Decimal BNB, at most 18 fraction digits, at most 1 BNB. It is a
# display-side product policy published as gasReservePolicy.walletGasReserveV1,
# never a chain fact.
WALLET_GAS_RESERVE_BNB=0.005

# Decision 0149: the worker lane fiat_fx_rate (default on) reads the USD→CNY
# reference rate from one named provider (no API key; default the European
# Central Bank reference rate via Frankfurter, which updates once per working
# day) and records it with its source and provider date in fiat_fx_rates. The
# net worth history `fiat` block reads that table (null until a rate exists).
# The URL must be https and name /providers/{key}/; the key is the `source`.
FIAT_FX_RATE_ENABLED=true
FIAT_FX_PROVIDER_URL=https://api.frankfurter.dev/v2/providers/ecb/rate/USD/CNY
FIAT_FX_REFRESH_SECONDS=3600

# Decision 0145: the worker lane wallet_networth_snapshot (default on) writes one
# USD net worth per recently active wallet per slot (default hourly, on the hour)
# into wallet_networth_snapshots. Needs BSC_RPC_URLS and the market fact cache.
WALLET_NETWORTH_SNAPSHOT_ENABLED=true
WALLET_NETWORTH_SNAPSHOT_INTERVAL_MS=3600000
WALLET_NETWORTH_SNAPSHOT_BATCH=200

# Default-off narrow BSC indexer lane in the standalone worker process. It
# indexes only ERC-20 Transfer/Approval logs of Asset Registry assets that
# touch an active LOOP wallet (Decision 0075), never the whole chain, and
# requires BSC_RPC_URLS. BSC_INDEXER_START_BLOCK seeds a brand-new lane; blank
# starts one reorg depth behind the head. BSC_INDEXER_WALLET_TOPIC_CHUNK_SIZE
# (1-1000, default 200) caps the wallet addresses per eth_getLogs topic array.
BSC_INDEXER_ENABLED=false
BSC_INDEXER_START_BLOCK=
BSC_INDEXER_WALLET_TOPIC_CHUNK_SIZE=200

# Token (emitter) addresses per eth_getLogs request for every log read of the
# BSC client (Decision 0078), 1-100, default 8: the public BSC endpoint refuses
# more than about 8 addresses with HTTP 403 "Request blocked". A tighter limit
# learned from a refusal is kept on the client; it never probes past this.
BSC_LOG_ADDRESS_CHUNK_SIZE=8

# Market Providers (Decision 0034). DexScreener needs no credential and is on
# by default (300 requests/minute documented; the throttle can only be
# lowered). GoPlus token-security facts need the key pair; without it every
# security fact and holder count is unavailable. GeckoTerminal (OHLCV, new
# pools) stays off until its commercial terms are verified. TTLs are seconds;
# a fact past its TTL is served as `stale` only inside the grace window and
# only when the Provider cannot be reached.
# The API and worker processes each get a per-minute budget; api + worker
# must not exceed 300, DexScreener's documented limit.
MARKET_PROVIDER_DEXSCREENER_ENABLED=true
MARKET_DEXSCREENER_BUDGET_API=120
MARKET_DEXSCREENER_BUDGET_WORKER=120
MARKET_PROVIDER_GECKOTERMINAL_ENABLED=false
MARKET_GECKOTERMINAL_RATE_LIMIT_PER_MINUTE=30
# Worker-process share of the same 30/min GeckoTerminal limit (Decision 0074);
# the API keeps MARKET_GECKOTERMINAL_RATE_LIMIT_PER_MINUTE. Both processes
# share one egress, so keep this small.
MARKET_GECKOTERMINAL_BUDGET_WORKER=10
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
MARKET_GOPLUS_RATE_LIMIT_PER_MINUTE=30
MARKET_PRICE_TTL_SECONDS=30
MARKET_SECURITY_TTL_SECONDS=600
MARKET_CANDLES_TTL_SECONDS=60
# Row sparkline cache row TTL (Decision 0074): the API publishes a row as
# fresh inside it, stale inside the grace window; the worker lane refreshes
# an asset once it is past it.
MARKET_SPARKLINE_TTL_SECONDS=300
MARKET_STALE_GRACE_SECONDS=900

# Which URL every published `logo.url` carries (Decision 0089 §8):
# `proxy` (default) = this API's /v2/market/logos/... proxy; `upstream` = the
# Decision 0072 origin (DexScreener image or Trust Wallet rule URL), for
# clients that only admit those hosts (TestFlight build 7). The proxy route is
# served in both modes. Any other value refuses to start.
TOKEN_LOGO_URL_MODE=proxy

# Default-on market sparkline warm lane in the standalone worker process
# (Decision 0074). It only runs with MARKET_PROVIDER_GECKOTERMINAL_ENABLED and
# refreshes at most one asset's 24 hourly closes per tick, skipping rows still
# inside MARKET_SPARKLINE_TTL_SECONDS; the overview reads those rows only.
MARKET_SPARKLINE_WARM_ENABLED=true
MARKET_SPARKLINE_WARM_INTERVAL_MS=4000

# Default-on token logo pre-warm lane in the standalone worker process
# (Decision 0161). Every TOKEN_LOGO_PREWARM_INTERVAL_MS (1 min - 24 h, default
# 6 h) it fetches into token_logo_cache, as 128 x 128 WebP, the logos of native
# BNB, the mainstream list, registry and watchlisted BSC assets, and up to
# TOKEN_LOGO_PREWARM_HOT_LIMIT (0-200; 0 skips it) GeckoTerminal top-volume
# tokens (needs MARKET_PROVIDER_GECKOTERMINAL_ENABLED). Rows are refreshed a day
# before their 7 days end; operator (manual) logos are never touched.
TOKEN_LOGO_PREWARM_ENABLED=true
TOKEN_LOGO_PREWARM_INTERVAL_MS=21600000
TOKEN_LOGO_PREWARM_HOT_LIMIT=200

# Default-on voice-room reaper lane in the standalone worker process
# (Decision 0094). Each tick (VOICE_ROOM_REAPER_INTERVAL_MS) it examines at
# most 50 live rooms and ends, through the same LOOP-then-Stream path as the
# host's end command:
# - a room live for VOICE_ROOM_MAX_LIVE_HOURS or more (log
#   VOICE_ROOM_MAX_AGE_ENDED), whoever is in it;
# - a room with no joined speaker or listener, no LOOP change for
#   VOICE_ROOM_IDLE_END_MINUTES, and a Stream session with zero connected
#   devices (log VOICE_ROOM_IDLE_ENDED). An unreadable Stream session keeps it.
# Needs STREAM_API_KEY / STREAM_API_SECRET; without them the lane stays off.
VOICE_ROOM_REAPER_ENABLED=true
VOICE_ROOM_REAPER_INTERVAL_MS=60000
VOICE_ROOM_IDLE_END_MINUTES=10
VOICE_ROOM_MAX_LIVE_HOURS=12

# Default-on friend direct channel lane in the standalone worker process
# (Decision 0172). Accepting a friend request or a message request enqueues the
# pair in friend_direct_channel_jobs inside the accept transaction; every
# FRIEND_DIRECT_CHANNEL_INTERVAL_MS (1 s - 10 min, default 5 s) the lane runs
# the same idempotent direct_get_or_create chat operation as
# POST /v2/chat/direct-channels for up to 20 due pairs. Refused pairs (no
# friendship any more, direct messages not allowed either way) are skipped.
# FRIEND_CHANNEL_BACKFILL_ENABLED (default false) also enqueues, each pass, up
# to 200 friendship pairs that have no direct channel and no job (logs
# "LOOP friend direct channel pass completed" with inserted / count).
# Needs STREAM_API_KEY / STREAM_API_SECRET; without them the lane stays off.
FRIEND_DIRECT_CHANNEL_ENABLED=true
FRIEND_DIRECT_CHANNEL_INTERVAL_MS=5000
FRIEND_CHANNEL_BACKFILL_ENABLED=false

# Default-on notification inbox lane in the standalone worker process
# (Decision 0177). Every NOTIFICATION_INBOX_INTERVAL_MS (1 s - 10 min, default
# 10 s) it writes the MEME v2 graduation notifications (every account whose
# wallet holds curve MEME or the badge, plus the project owner) and the
# badge-minted notification of each newly indexed mint (facts older than 24 h
# are marked without a notification). With NOTIFICATION_INBOX_EMIT=on and the
# push channel configured it also pushes fine inbox events younger than 30
# minutes (friend requests / acceptances are written by the API itself).
NOTIFICATION_INBOX_ENABLED=true
NOTIFICATION_INBOX_INTERVAL_MS=10000

# Default-off alert evaluator lane in the standalone worker process. It reads
# only fresh DexScreener prices (requires MARKET_PROVIDER_DEXSCREENER_ENABLED),
# flips a satisfied V2 alert to `triggered`, and writes one context
# notification per alert per dedupe window. When the push channel below is
# configured it also pushes the trigger pointer to the owner's devices.
ALERT_EVALUATOR_ENABLED=false
ALERT_NOTIFICATION_DEDUPE_SECONDS=3600

# Community AI (Decision 0066, amended 2026-09-23). COMMUNITY_AI_BASE_URL is
# the Anthropic-compatible Provider origin: https only, no credentials, no
# path/query/fragment (the adapter appends /v1/messages). The Development
# stack points it at https://api.onlyrouter.ai. COMMUNITY_AI_API_KEY is the
# Provider key and takes precedence over ANTHROPIC_API_KEY; with neither set
# the communityAi capability stays deferred (COMMUNITY_AI_RUNTIME_DEFERRED)
# and no answer is ever produced. Never commit a real key.
COMMUNITY_AI_BASE_URL=https://api.anthropic.com
COMMUNITY_AI_API_KEY=
# COMMUNITY_AI_TIMEOUT_MS (default 11000) bounds the model call inside an ask
# request so it ends in a 503 before the 15 s HTTP deadlines. The background
# brief answers no request and has its own ceiling (default 30000, 5000-120000).
COMMUNITY_AI_BRIEF_TIMEOUT_MS=30000

# Push channel (Decision 0067). The path of the Firebase service-account JSON
# used for FCM HTTP v1; both Android and iOS are addressed through FCM, iOS via
# the APNs key uploaded in the Firebase console. This is a PATH, never the key:
# keep the file outside Git and outside any image layer. Blank keeps
# `pushNotifications` unavailable with PUSH_RUNTIME_DEFERRED, refuses
# POST /v2/devices/push-token, and leaves every producer feed-only.
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

# Passkey relying-party association files (Decision 0063). None of these is a
# secret; they are published verbatim at /.well-known. Without
# PASSKEY_ANDROID_CERT_SHA256 assetlinks.json carries no passkey statement.
# PASSKEY_IOS_TEAM_ID + PASSKEY_IOS_BUNDLE_ID form the only iOS application
# identifier (<TEAMID>.<BUNDLEID>) the API publishes, for both passkeys and
# Universal Links (Decision 0106). Without PASSKEY_IOS_TEAM_ID the
# apple-app-site-association file claims no iOS app ({"applinks":{"details":[]}})
# and startup logs one APPLE_TEAM_ID_MISSING warning. The bundle ID defaults to
# com.cywd.loopapp; there is no default Team ID.
# Fingerprints are comma-separated, 32 colon-separated hex byte pairs each
# (`keytool -list -v -keystore <store>` prints them); add one per keystore that
# signs a build which must reach LOOP passkeys.
PASSKEY_ANDROID_PACKAGE=com.cywd.loop
PASSKEY_ANDROID_CERT_SHA256=
PASSKEY_IOS_TEAM_ID=
PASSKEY_IOS_BUNDLE_ID=com.cywd.loopapp

# Universal Links / App Links for shared LOOP ID links (Decision 0090). The
# Android package and the debug keystore fingerprint are built in; the iOS app
# ID comes from PASSKEY_IOS_TEAM_ID + PASSKEY_IOS_BUNDLE_ID above (Decision 0106). ANDROID_RELEASE_CERT_SHA256 appends the release
# signing fingerprint(s) (comma-separated) to assetlinks.json; blank publishes
# the debug keystore only. APP_DOWNLOAD_URL (https only) adds a download link to
# the /u/{loopId} landing page; blank shows no link.
ANDROID_RELEASE_CERT_SHA256=
APP_DOWNLOAD_URL=
# Decision 0162: store links of the /i/{code} invite landing page (the page the
# shared invite link opens when LOOP is not installed). APP_STORE_URL_IOS = the
# App Store (or TestFlight) URL, APP_STORE_URL_ANDROID = the Google Play (or APK
# download) URL. https only, no credentials, else startup fails. Blank hides
# that store link; with neither, the copy-and-download button falls back to
# APP_DOWNLOAD_URL, and with none of the three it only copies the code.
APP_STORE_URL_IOS=
APP_STORE_URL_ANDROID=

# Decision 0179: web registration surface /v2/web/* for the LOOP website
# (loop-web, same Privy App). WEB_ORIGINS = comma list of the website origins
# allowed to call it cross-origin (https, no path/query; http://localhost only
# outside production). Blank (default) = the whole /v2/web surface is NOT
# mounted (404) and every other route stays same-origin. The matching origin is
# echoed in Access-Control-Allow-Origin (never `*`), with Vary: Origin.
#   e.g. WEB_ORIGINS=https://loop.example,https://www.loop.example
WEB_ORIGINS=
# Decision 0180: GET /v2/web/referral/me also needs the referral module and
#   V2_CURSOR_HMAC_SECRET (503 V2_CURSOR_NOT_CONFIGURED without it); no new key.
# Website root (https, no query/fragment). When set, GET /i/{code} answers
# 302 to ${WEB_BASE_URL}/i/{code} instead of the API's own landing page; the
# Universal Link / App Link host stays the API domain. Blank keeps the page.
#   e.g. WEB_BASE_URL=https://loop.example
WEB_BASE_URL=
# Store links GET /v2/web/meta publishes (https, no credentials; blank = null).
WEB_APP_LINKS_IOS=
WEB_APP_LINKS_ANDROID=
WEB_APP_LINKS_TESTFLIGHT=

# Local-only credentials must match compose.yaml. Replace them outside local dev.
# The standalone reconciliation worker reads NODE_ENV, LOG_LEVEL, DATABASE_*,
# and the explicit reconciliation/quota settings above. It loads no Privy,
# wallet, signer, Exchange, relay, or provider-write credential.
DATABASE_URL=postgres://loop_api:loop_api_local_only@127.0.0.1:5432/loop_api_dev
# `pnpm test:integration` reads ONLY this variable and never falls back to
# DATABASE_URL. It must point at a separate, disposable database whose name
# contains `test` (the suites truncate tables). Create it once with
# `CREATE DATABASE loop_api_test OWNER loop_api;` and run `pnpm db:migrate:test`.
DATABASE_URL_TEST=
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=5000
