# Safe local-development defaults. Copy to .env.local; never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
API_DOCS_ENABLED=true
TRUST_PROXY=false
LOG_LEVEL=info

# Leave blank until configured in the Privy dashboard. Never commit real values.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Leave blank until the Stream license and Development App gates close.
# Chat and Video share this one Stream App. Never commit the API secret.
STREAM_API_KEY=
STREAM_API_SECRET=

# Independent server-only HMAC key for privacy-preserving user/IP quota buckets.
# Generate at least 32 random bytes outside Git. Limits are per 60-second window.
STREAM_TOKEN_QUOTA_HMAC_SECRET=
STREAM_TOKEN_USER_LIMIT_PER_MINUTE=10
STREAM_TOKEN_IP_LIMIT_PER_MINUTE=60

# Independent server-only HMAC key for owner/wallet/route-bound Perp read cursors.
# Leave blank while private reads are unavailable. Never commit the real value.
PERP_READ_CURSOR_HMAC_SECRET=

# Hyperliquid private reads are default-off and fixed to Testnet/Core.
# Enabling requires Privy credentials, the cursor key above, and a separate
# server-only quota HMAC key. The internal limit stays below provider 1200/min.
HYPERLIQUID_PRIVATE_READS_ENABLED=false
HYPERLIQUID_INFO_QUOTA_HMAC_SECRET=
HYPERLIQUID_INFO_WEIGHT_LIMIT_PER_MINUTE=960

# Local-only credentials must match compose.yaml. Replace them outside local dev.
DATABASE_URL=postgres://loop_api:loop_api_local_only@127.0.0.1:5432/loop_api_dev
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_STATEMENT_TIMEOUT_MS=5000
