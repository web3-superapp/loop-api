{
  "name": "@loop/api",
  "version": "0.1.0",
  "private": true,
  "description": "Private Backend-for-Frontend for the LOOP Flutter app",
  "type": "module",
  "engines": {
    "node": "24.19.x",
    "pnpm": "10.28.x"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "asset:register": "node --env-file-if-exists=.env.local --import tsx scripts/asset-register.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm openapi:check && pnpm test && pnpm build",
    "community:persona-backfill": "node --env-file-if-exists=.env.local --import tsx scripts/community-persona-backfill.ts",
    "community:provision-channels": "node --env-file-if-exists=.env.local --import tsx scripts/community-provision-channels.ts",
    "community:verify": "node --env-file-if-exists=.env.local --import tsx scripts/community-verify.ts",
    "db:create-migration": "node-pg-migrate create --migration-file-language ts --migration-filename-format index",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/node-pg-migrate/bin/node-pg-migrate up --migrations-dir migrations --pretty",
    "db:migrate:test": "node --env-file-if-exists=.env.local ./node_modules/node-pg-migrate/bin/node-pg-migrate up --migrations-dir migrations --pretty --database-url-var DATABASE_URL_TEST",
    "db:rollback": "node --env-file-if-exists=.env.local ./node_modules/node-pg-migrate/bin/node-pg-migrate down --migrations-dir migrations --pretty",
    "db:stop": "docker compose stop postgres",
    "db:up": "docker compose up -d --wait postgres",
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "docker:build:migration": "docker build --target migration --tag loop-api:migration .",
    "docker:build:runtime": "docker build --target runtime --tag loop-api:runtime .",
    "docker:build:worker": "docker build --target worker --tag loop-api:worker .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "identity-stream:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/identity-stream-smoke.ts",
    "indexer:backfill": "node --env-file-if-exists=.env.local --import tsx scripts/indexer-backfill.ts",
    "launch:milestone": "node --env-file-if-exists=.env.local --import tsx scripts/launch-milestone.ts",
    "launch:review": "node --env-file-if-exists=.env.local --import tsx scripts/launch-review.ts",
    "lint": "eslint .",
    "mining:approve-formula": "node --env-file-if-exists=.env.local --import tsx scripts/mining-approve-formula.ts",
    "mining:community-weight": "node --env-file-if-exists=.env.local --import tsx scripts/mining-community-weight.ts",
    "mining:dev-baseline": "node --env-file-if-exists=.env.local --import tsx scripts/mining-dev-baseline.ts",
    "mining:snapshot": "node --env-file-if-exists=.env.local --import tsx scripts/mining-snapshot.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "openapi:generate": "tsx scripts/generate-openapi.ts --write",
    "pool:register": "node --env-file-if-exists=.env.local --import tsx scripts/pool-register.ts",
    "secrets:check": "tsx scripts/check-tracked-secrets.ts",
    "start": "node dist/src/server.js",
    "start:local": "node --env-file-if-exists=.env.local dist/src/server.js",
    "stream:verify": "node --env-file-if-exists=.env.local --import tsx scripts/verify-stream-credentials.ts",
    "support:answer": "node --env-file-if-exists=.env.local --import tsx scripts/support-answer.ts",
    "voice-room:open": "node --env-file-if-exists=.env.local --import tsx scripts/voice-room-open.ts",
    "test": "vitest run --exclude 'test/**/*.integration.test.ts'",
    "test:contract": "vitest run test/*contract.test.ts test/*routes.test.ts test/app.test.ts test/bootstrap.test.ts test/database-schema.test.ts test/openapi.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx scripts/run-integration-tests.ts",
    "test:watch": "vitest",
    "test:worker": "vitest run test/authoritative-reader-registry.test.ts test/reconciliation-service.test.ts test/worker.test.ts test/reconciliation-worker-config.test.ts test/reconciliation-worker-logger.test.ts test/reconciliation-worker-readers.test.ts test/worker-runtime.test.ts test/issuance-quota-retention-worker.test.ts test/spot-agent-lifecycle-worker.test.ts test/perp-order-reconciliation-handler.test.ts test/hyperliquid-perp-order-reconciliation-reader.test.ts test/hyperliquid-lossless-info-transport.test.ts test/spot-order-reconciliation-handler.test.ts test/hyperliquid-spot-order-reconciliation-reader.test.ts",
    "typecheck": "tsc --noEmit",
    "worker:dev": "node --env-file-if-exists=.env.local --import tsx src/reconciliation-worker.ts",
    "worker:start": "node dist/src/reconciliation-worker.js",
    "worker:start:local": "node --env-file-if-exists=.env.local dist/src/reconciliation-worker.js"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/swagger": "9.8.1",
    "@nktkas/hyperliquid": "0.33.3",
    "@privy-io/node": "0.29.0",
    "@stream-io/node-sdk": "0.7.63",
    "fastify": "5.12.1",
    "lossless-json": "4.3.1",
    "pg": "8.23.0",
    "viem": "2.44.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "10.9.0",
    "node-pg-migrate": "9.0.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
