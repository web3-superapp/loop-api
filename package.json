{
  "name": "@loop/api",
  "version": "0.1.0",
  "private": true,
  "description": "Private Backend-for-Frontend for the LOOP Flutter app",
  "type": "module",
  "engines": {
    "node": "24.19.x",
    "pnpm": "10.28.x"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm openapi:check && pnpm test && pnpm build",
    "db:create-migration": "node-pg-migrate create --migration-file-language ts --migration-filename-format index",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/node-pg-migrate/bin/node-pg-migrate up --migrations-dir migrations --pretty",
    "db:rollback": "node --env-file-if-exists=.env.local ./node_modules/node-pg-migrate/bin/node-pg-migrate down --migrations-dir migrations --pretty",
    "db:stop": "docker compose stop postgres",
    "db:up": "docker compose up -d --wait postgres",
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "openapi:generate": "tsx scripts/generate-openapi.ts --write",
    "start": "node dist/src/server.js",
    "start:local": "node --env-file-if-exists=.env.local dist/src/server.js",
    "test": "vitest run --exclude 'test/**/*.integration.test.ts'",
    "test:integration": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --no-file-parallelism test/internal-user-repository.integration.test.ts test/control-plane-repository.integration.test.ts test/perp-intent-repository.integration.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/swagger": "9.8.1",
    "@privy-io/node": "0.29.0",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "10.9.0",
    "node-pg-migrate": "9.0.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
