{
  "name": "@loop/api",
  "version": "0.1.0",
  "private": true,
  "description": "Private Backend-for-Frontend for the LOOP Flutter app",
  "type": "module",
  "engines": {
    "node": "24.19.x",
    "pnpm": "10.28.x"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm openapi:check && pnpm test && pnpm build",
    "db:create-migration": "node-pg-migrate create --migration-file-language ts --migration-filename-format index",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/node-pg-migrate/bin/node-pg-migrate up --migrations-dir migrations --pretty",
    "db:rollback": "node --env-file-if-exists=.env.local ./node_modules/node-pg-migrate/bin/node-pg-migrate down --migrations-dir migrations --pretty",
    "db:stop": "docker compose stop postgres",
    "db:up": "docker compose up -d --wait postgres",
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "docker:build:migration": "docker build --target migration --tag loop-api:migration .",
    "docker:build:runtime": "docker build --target runtime --tag loop-api:runtime .",
    "docker:build:worker": "docker build --target worker --tag loop-api:worker .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "openapi:generate": "tsx scripts/generate-openapi.ts --write",
    "secrets:check": "tsx scripts/check-tracked-secrets.ts",
    "start": "node dist/src/server.js",
    "start:local": "node --env-file-if-exists=.env.local dist/src/server.js",
    "test": "vitest run --exclude 'test/**/*.integration.test.ts'",
    "test:contract": "vitest run test/*contract.test.ts test/*routes.test.ts test/app.test.ts test/bootstrap.test.ts test/database-schema.test.ts test/openapi.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --no-file-parallelism test/internal-user-repository.integration.test.ts test/control-plane-repository.integration.test.ts test/perp-intent-repository.integration.test.ts test/perp-reconciliation-repository.integration.test.ts test/perp-wallet-binding-repository.integration.test.ts test/perp-wallet-binding-migration.integration.test.ts test/agent-authorization-repository.integration.test.ts test/agent-authorization-migration.integration.test.ts test/spot-closed-loop-migration.integration.test.ts test/spot-intent-repository.integration.test.ts test/spot-agent-authorization-repository.integration.test.ts test/profile-repository.integration.test.ts test/watchlist-repository.integration.test.ts test/alert-repository.integration.test.ts test/reconciliation-worker-process.integration.test.ts",
    "test:worker": "vitest run test/authoritative-reader-registry.test.ts test/reconciliation-service.test.ts test/worker.test.ts test/reconciliation-worker-config.test.ts test/reconciliation-worker-logger.test.ts test/reconciliation-worker-readers.test.ts test/worker-runtime.test.ts test/perp-order-reconciliation-handler.test.ts test/hyperliquid-perp-order-reconciliation-reader.test.ts test/hyperliquid-lossless-info-transport.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker:dev": "node --env-file-if-exists=.env.local --import tsx src/reconciliation-worker.ts",
    "worker:start": "node dist/src/reconciliation-worker.js",
    "worker:start:local": "node --env-file-if-exists=.env.local dist/src/reconciliation-worker.js"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/swagger": "9.8.1",
    "@privy-io/node": "0.29.0",
    "fastify": "5.12.1",
    "lossless-json": "4.3.1",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "eslint": "10.9.0",
    "node-pg-migrate": "9.0.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
