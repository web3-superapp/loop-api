                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["status", "checks"],
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": ["ready", "not_ready"]
                        },
                        "checks": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["database"],
